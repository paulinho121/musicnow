# Ensaio Fácil — instalado pelo deploy em /etc/caddy/ensaio-facil.caddy.
# __DOMAIN__ e __OLD_DOMAIN__ são substituídos na hora do deploy (deploy/deploy.sh).

# O site (produção e teste usam o mesmo bloco): {args[0]} = porta da API, {args[1]} = pasta do app.
(ensaio_site) {
	# Conexão ao vivo (Modo Palco): sem compressão nem buffer, cada aviso sai na hora.
	@live path_regexp live ^/api/setlists/[^/]+/events$
	@compress not path_regexp ^/api/setlists/[^/]+/events$
	encode @compress zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), screen-wake-lock=(self), fullscreen=(self \"https://www.youtube-nocookie.com\" \"https://open.spotify.com\" \"https://widget.deezer.com\" \"https://embed.music.apple.com\"), encrypted-media=(self \"https://www.youtube-nocookie.com\" \"https://open.spotify.com\" \"https://widget.deezer.com\" \"https://embed.music.apple.com\"), picture-in-picture=(self \"https://www.youtube-nocookie.com\"), autoplay=(self \"https://open.spotify.com\" \"https://widget.deezer.com\" \"https://embed.music.apple.com\"), clipboard-write=(self \"https://open.spotify.com\" \"https://widget.deezer.com\")"
		# Só executa scripts vindos do próprio site: bloqueia scripts injetados (XSS).
		# frame-src: só os players oficiais (YouTube, Spotify, Deezer, Apple Music) da gravação de referência.
		# style 'unsafe-inline' é necessário para os estilos dinâmicos do React (tamanho da fonte da cifra).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; media-src 'self' blob:; manifest-src 'self'; frame-src https://www.youtube-nocookie.com https://open.spotify.com https://widget.deezer.com https://embed.music.apple.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	handle @live {
		reverse_proxy 127.0.0.1:{args[0]} {
			flush_interval -1
		}
	}

	# Links de convite e de música compartilhada: a API devolve a página do app com a prévia
	# daquele repertório/música (título e descrição para o WhatsApp e as redes).
	@preview path /convite/* /compartilhado/*
	handle @preview {
		rewrite * /api/og{uri}
		reverse_proxy 127.0.0.1:{args[0]}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:{args[0]}
	}

	handle {
		root * {args[1]}
		@static path /assets/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"
		# Vídeo da abertura: o Caddy entrega .webm como audio/webm; para <video> o certo é video/webm.
		@webm path *.webm
		header @webm >Content-Type video/webm
		# Páginas públicas pré-geradas (acordes, transpositor...) saem prontas; o resto é o app.
		try_files {path} {path}/index.html /index.html
		file_server
	}
}

__DOMAIN__ {
	import ensaio_site 3001 /var/www/ensaio-facil
}

# Versão de teste: outro banco e outra API (porta 3012). Fora do Google (noindex).
teste.__DOMAIN__ {
	header X-Robots-Tag "noindex, nofollow"
	import ensaio_site 3012 /var/www/ensaio-facil-teste
}

# www.ensaiofacil.app.br → ensaiofacil.app.br
www.__DOMAIN__ {
	redir https://__DOMAIN__{uri} permanent
}

# Endereço antigo (sslip.io): links já compartilhados continuam funcionando, levando ao novo.
# A API continua respondendo aqui por um tempo (avisos do Asaas configurados no endereço antigo).
__OLD_DOMAIN__ {
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}
	handle {
		redir https://__DOMAIN__{uri} permanent
	}
}
